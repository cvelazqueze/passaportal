generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  CANDIDATE
  RECRUITER
  HIRING_MANAGER
  AGENCY_ADMIN
  PLATFORM_ADMIN
}

enum OrganizationType {
  AGENCY
  ENTERPRISE
  INDEPENDENT
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ResumeTemplate {
  ATS
  TECHNICAL
  EXECUTIVE
  CORPORATE
  MODERN
}

enum ApplicationStage {
  INTERESTED
  APPLIED
  RECRUITER_CONTACTED
  SCREENING
  TECHNICAL_INTERVIEW
  HIRING_MANAGER_INTERVIEW
  FINAL_INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
}

enum DocumentType {
  RESUME
  CERTIFICATION
  COVER_LETTER
  PORTFOLIO
  SUPPORTING
  OTHER
}

enum InterviewType {
  PHONE
  VIDEO
  ONSITE
  TECHNICAL
  BEHAVIORAL
  PANEL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum NotificationType {
  INTERVIEW_SCHEDULED
  FEEDBACK_ADDED
  STAGE_CHANGED
  DOCUMENT_REQUESTED
  CANDIDATE_SUBMITTED
  APPLICATION_UPDATE
  SYSTEM
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  SHARE
  PERMISSION_CHANGE
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  PASSWORD_CHANGE
  PASSWORD_RESET
  SESSION_EXPIRED
  ACCOUNT_LOCKED
  SUSPICIOUS_ACTIVITY
  DATA_EXPORT
  PERMISSION_DENIED
}

enum JobStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
  FILLED
}

enum ScorecardRating {
  POOR
  BELOW_AVERAGE
  AVERAGE
  GOOD
  EXCELLENT
}

enum OverallRecommendation {
  STRONG_NO
  NO
  NEUTRAL
  YES
  STRONG_YES
}

enum Visibility {
  PRIVATE
  ORGANIZATION
  SHARED
  PUBLIC
}

enum ResumeVersionStatus {
  ACTIVE
  ARCHIVED
}

enum InterviewQuestionType {
  TECHNICAL
  BEHAVIORAL
}

enum ResumeExportFormat {
  PDF
  DOCX
}

// ============================================================================
// AUTH & USERS
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  firstName     String
  lastName      String
  image         String?
  role          UserRole  @default(CANDIDATE)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  organizationMember OrganizationMember?
  candidateProfile   CandidateProfile?
  recruiterProfile   RecruiterProfile?
  hiringManagerProfile HiringManagerProfile?
  loginHistory       LoginHistory[]
  devices            UserDevice[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  securityEvents     SecurityEvent[]
  feedbackGiven      Feedback[]          @relation("FeedbackAuthor")
  notes              Note[]
  interviewsAsInterviewer InterviewInterviewer[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  deviceId     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("login_history")
}

model UserDevice {
  id         String   @id @default(cuid())
  userId     String
  deviceName String?
  deviceType String?
  browser    String?
  os         String?
  ipAddress  String?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_devices")
}

// ============================================================================
// ORGANIZATIONS & MULTI-TENANCY
// ============================================================================

model Organization {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  type             OrganizationType @default(AGENCY)
  logo             String?
  website          String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  members          OrganizationMember[]
  subscription     Subscription?
  jobs             Job[]
  talentPools      TalentPool[]
  clients          Client[]
  auditLogs        AuditLog[]
  securityEvents   SecurityEvent[]

  @@index([slug])
  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  userId         String   @unique
  organizationId String
  role           UserRole
  isActive       Boolean  @default(true)
  joinedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  MemberPermission[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

model Permission {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  resource    String
  action      String

  rolePermissions  RolePermission[]
  memberPermissions MemberPermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  role         UserRole
  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@map("role_permissions")
}

model MemberPermission {
  id                   String @id @default(cuid())
  organizationMemberId String
  permissionId         String
  granted              Boolean @default(true)

  organizationMember OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)
  permission         Permission         @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([organizationMemberId, permissionId])
  @@map("member_permissions")
}

model Client {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contactEmail   String?
  contactPhone   String?
  website        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs         Job[]

  @@index([organizationId])
  @@map("clients")
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ============================================================================
// CANDIDATE PROFILES & TALENT PASSPORT
// ============================================================================

model CandidateProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  talentPassport    TalentPassport?
  applications      Application[]
  talentPoolMembers TalentPoolMember[]
  pipelineStages    CandidatePipelineStage[]
  jobWorkspaces     JobDescriptionWorkspace[]
  rejectionReasons  RejectionReason[]

  @@map("candidate_profiles")
}

model TalentPassport {
  id                  String     @id @default(cuid())
  candidateProfileId  String     @unique
  professionalTitle   String?
  phone               String?
  linkedIn            String?
  portfolio           String?
  github              String?
  city                String?
  country             String?
  technologies        String[]   @default([])
  professionalSummary String?    @db.Text
  careerGoals         String?    @db.Text
  salaryExpectation   String?    // Encrypted at application layer
  salaryVisibility    Visibility @default(PRIVATE)
  completeness        Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  experiences      Experience[]
  skills           Skill[]
  languages        Language[]
  certifications   Certification[]
  education        Education[]
  projects         Project[]
  awards           Award[]
  publications     Publication[]
  resumeVersions   ResumeVersion[]
  documents        Document[]

  @@map("talent_passports")
}

model Experience {
  id               String    @id @default(cuid())
  talentPassportId String
  company          String
  location         String?
  position         String
  startDate        DateTime
  endDate          DateTime?
  isCurrent        Boolean   @default(false)
  achievements     String[]  @default([])
  responsibilities String[]  @default([])
  technologies     String[]  @default([])
  impactMetrics    String[]  @default([])
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  talentPassport TalentPassport @relation(fields: [talentPassportId], references: [id], onDelete: Cascade)

  @@index([talentPassportId])
  @@map("experiences")
}

model Skill {
  id               String           @id @default(cuid())
  talentPassportId String
  name             String
  category         String?
  yearsExperience  Float?
  proficiency      ProficiencyLevel @default(INTERMEDIATE)
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  talentPassport TalentPassport @relation(fields: [talentPassportId], references: [id], onDelete: Cascade)

  @@index([talentPassportId])
  @@index([name])
  @@map("skills")
}

model Language {
  id               String           @id @default(cuid())
  talentPassportId String
  name             String
  proficiency      ProficiencyLevel @default(INTERMEDIATE)
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  talentPassport TalentPassport @relation(fields: [talentPassportId], references: [id], onDelete: Cascade)

  @@index([talentPassportId])
  @@map("languages")
}

model Certification {
  id               String    @id @default(cuid())
  talentPassportId String
  name             String
  issuer           String
  credentialUrl    String?
  issueDate        DateTime?
  expirationDate   DateTime?
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  talentPassport TalentPassport @relation(fields: [talentPassportId], references: [id], onDelete: Cascade)

  @@index([talentPassportId])
  @@map("certifications")
}

model Education {
  id               String    @id @default(cuid())
  talentPassportId String
  institution      String
  location         String?
  degree           String
  fieldOfStudy     String?
  startDate        DateTime
  endDate          DateTime?
  description      String?   @db.Text
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  talentPassport TalentPassport @relation(fields: [talentPassportId], references: [id], onDelete: Cascade)

  @@index([talentPassportId])
  @@map("education")
}

model Project {
  id               String   @id @default(cuid())
  talentPassportId String
  title            String
  description      String?  @db.Text
  technologies     String[] @default([])
  outcomes         String[] @default([])
  urls             String[] @default([])
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  talentPassport TalentPassport @relation(fields: [talentPassportId], references: [id], onDelete: Cascade)

  @@index([talentPassportId])
  @@map("projects")
}

model Award {
  id               String    @id @default(cuid())
  talentPassportId String
  title            String
  issuer           String?
  date             DateTime?
  description      String?   @db.Text
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  talentPassport TalentPassport @relation(fields: [talentPassportId], references: [id], onDelete: Cascade)

  @@index([talentPassportId])
  @@map("awards")
}

model Publication {
  id               String    @id @default(cuid())
  talentPassportId String
  title            String
  publisher        String?
  url              String?
  publishDate      DateTime?
  description      String?   @db.Text
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  talentPassport TalentPassport @relation(fields: [talentPassportId], references: [id], onDelete: Cascade)

  @@index([talentPassportId])
  @@map("publications")
}

// ============================================================================
// RESUME BUILDER
// ============================================================================

model ResumeVersion {
  id               String              @id @default(cuid())
  talentPassportId String
  name             String
  template         ResumeTemplate      @default(MODERN)
  targetRole       String?
  includedSections Json                @default("{}")
  customizations   Json                @default("{}")
  isDefault        Boolean             @default(false)
  isMaster         Boolean             @default(false)
  status           ResumeVersionStatus @default(ACTIVE)
  archivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  talentPassport       TalentPassport            @relation(fields: [talentPassportId], references: [id], onDelete: Cascade)
  documents            Document[]
  exportHistory        ResumeExportHistory[]
  jobWorkspaces        JobDescriptionWorkspace[]

  @@index([talentPassportId])
  @@index([status])
  @@map("resume_versions")
}

model ResumeExportHistory {
  id              String             @id @default(cuid())
  resumeVersionId String
  format          ResumeExportFormat
  exportedAt      DateTime           @default(now())

  resumeVersion ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@index([resumeVersionId])
  @@map("resume_export_history")
}

// ============================================================================
// DOCUMENTS
// ============================================================================

model Document {
  id               String       @id @default(cuid())
  talentPassportId String?
  resumeVersionId  String?
  applicationId    String?
  type             DocumentType
  name             String
  fileUrl          String
  fileKey          String
  fileSize         Int
  mimeType         String
  visibility       Visibility   @default(PRIVATE)
  uploadedById     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  talentPassport TalentPassport? @relation(fields: [talentPassportId], references: [id], onDelete: SetNull)
  resumeVersion  ResumeVersion?  @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  application    Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([talentPassportId])
  @@index([applicationId])
  @@map("documents")
}

// ============================================================================
// RECRUITER PROFILES
// ============================================================================

model RecruiterProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  title     String?
  bio       String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recruiter_profiles")
}

model HiringManagerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  title     String?
  department String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[] @relation("JobHiringManager")

  @@map("hiring_manager_profiles")
}

// ============================================================================
// JOBS & APPLICATIONS
// ============================================================================

model Job {
  id               String    @id @default(cuid())
  organizationId   String
  clientId         String?
  hiringManagerId  String?
  title            String
  description      String    @db.Text
  requirements     String[]  @default([])
  preferredSkills  String[]  @default([])
  requiredSkills   String[]  @default([])
  location         String?
  remote           Boolean   @default(false)
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String?   @default("USD")
  status           JobStatus @default(DRAFT)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client        Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  hiringManager HiringManagerProfile? @relation("JobHiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  applications  Application[]

  @@index([organizationId])
  @@index([status])
  @@map("jobs")
}

model Application {
  id                 String           @id @default(cuid())
  candidateProfileId String
  jobId              String?
  organizationId     String?
  pipelineStageId    String?
  title              String?
  company            String?
  client             String?
  recruiterName      String?
  recruiterContact   String?
  stage              ApplicationStage @default(INTERESTED)
  stageOrder         Int              @default(0)
  appliedAt          DateTime?
  salaryMin          Int?
  salaryMax          Int?
  salaryCurrency     String?          @default("USD")
  contractType       String?
  benefits           String[]         @default([])
  technologies       String[]         @default([])
  source             String?
  resumeVersionId    String?
  notes              String?          @db.Text
  score              Float?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  candidateProfile       CandidateProfile          @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  job                    Job?                      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  pipelineStage          CandidatePipelineStage?   @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  interviews             Interview[]
  feedback               Feedback[]
  applicationNotes       Note[]
  documents              Document[]
  scorecards             Scorecard[]
  stageHistory           ApplicationStageHistory[]
  candidateInterviews    CandidateInterviewSession[]
  takeHomeAssignments    TakeHomeAssignment[]
  rejectionRecords       RejectionRecord[]
  offer                  Offer?

  @@index([candidateProfileId])
  @@index([jobId])
  @@index([stage])
  @@index([pipelineStageId])
  @@map("applications")
}

model ApplicationStageHistory {
  id            String           @id @default(cuid())
  applicationId String
  fromStage     ApplicationStage?
  toStage       ApplicationStage
  changedById   String?
  reason        String?
  createdAt     DateTime         @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_stage_history")
}

// ============================================================================
// INTERVIEWS & FEEDBACK
// ============================================================================

model Interview {
  id            String          @id @default(cuid())
  applicationId String
  type          InterviewType
  status        InterviewStatus @default(SCHEDULED)
  scheduledAt   DateTime
  duration      Int             @default(60)
  location      String?
  meetingUrl    String?
  notes         String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  application  Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewers InterviewInterviewer[]
  feedback     Feedback[]

  @@index([applicationId])
  @@index([scheduledAt])
  @@map("interviews")
}

model InterviewInterviewer {
  id          String @id @default(cuid())
  interviewId String
  userId      String

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
  @@map("interview_interviewers")
}

model Feedback {
  id            String   @id @default(cuid())
  applicationId String
  interviewId   String?
  authorId      String
  content       String   @db.Text
  isPrivate     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interview   Interview?  @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  author      User        @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("feedback")
}

model Scorecard {
  id                     String                @id @default(cuid())
  applicationId          String
  evaluatorId            String
  technicalSkills        ScorecardRating?
  communication          ScorecardRating?
  leadership             ScorecardRating?
  problemSolving         ScorecardRating?
  teamwork               ScorecardRating?
  overallRecommendation  OverallRecommendation?
  notes                  String?               @db.Text
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("scorecards")
}

model Note {
  id            String   @id @default(cuid())
  applicationId String
  authorId      String
  content       String   @db.Text
  isPrivate     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("notes")
}

// ============================================================================
// TALENT POOLS
// ============================================================================

model TalentPool {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?  @db.Text
  criteria       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TalentPoolMember[]

  @@index([organizationId])
  @@map("talent_pools")
}

model TalentPoolMember {
  id                 String   @id @default(cuid())
  talentPoolId       String
  candidateProfileId String
  rank               Int?
  score              Float?
  notes              String?  @db.Text
  addedAt            DateTime @default(now())

  talentPool       TalentPool       @relation(fields: [talentPoolId], references: [id], onDelete: Cascade)
  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@unique([talentPoolId, candidateProfileId])
  @@index([talentPoolId])
  @@map("talent_pool_members")
}

// ============================================================================
// CANDIDATE COPILOT MODULES
// ============================================================================

model CandidatePipelineStage {
  id                 String   @id @default(cuid())
  candidateProfileId String
  name               String
  color              String   @default("bg-slate-100")
  sortOrder          Int      @default(0)
  isArchived         Boolean  @default(false)
  isSystemDefault    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  applications     Application[]

  @@index([candidateProfileId])
  @@map("candidate_pipeline_stages")
}

model JobDescriptionWorkspace {
  id                 String   @id @default(cuid())
  candidateProfileId String
  jobTitle           String
  company            String
  description        String   @db.Text
  analysis           Json     @default("{}")
  matchAnalysis      Json     @default("{}")
  resumeVersionId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  resumeVersion    ResumeVersion?   @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)

  @@index([candidateProfileId])
  @@map("job_description_workspaces")
}

model CandidateInterviewSession {
  id             String          @id @default(cuid())
  applicationId  String
  interviewDate  DateTime
  interviewType  InterviewType
  interviewer    String?
  notes          String?         @db.Text
  outcome        String?
  lessonsLearned String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  application Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questions   InterviewQuestionRecord[]

  @@index([applicationId])
  @@index([interviewDate])
  @@map("candidate_interview_sessions")
}

model InterviewQuestionRecord {
  id           String                @id @default(cuid())
  sessionId    String
  questionType InterviewQuestionType
  question     String                @db.Text
  notes        String?               @db.Text
  createdAt    DateTime              @default(now())

  session CandidateInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("interview_question_records")
}

model TakeHomeAssignment {
  id            String    @id @default(cuid())
  applicationId String
  title         String
  description   String?   @db.Text
  submittedAt   DateTime?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("take_home_assignments")
}

model RejectionReason {
  id                 String   @id @default(cuid())
  candidateProfileId String?
  label              String
  isSystemDefault    Boolean  @default(false)
  createdAt          DateTime @default(now())

  candidateProfile CandidateProfile? @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  rejectionRecords RejectionRecord[]

  @@index([candidateProfileId])
  @@map("rejection_reasons")
}

model RejectionRecord {
  id             String   @id @default(cuid())
  applicationId  String
  reasonId       String?
  stageName      String?
  rejectedAt     DateTime @default(now())
  candidateNotes String?  @db.Text
  createdAt      DateTime @default(now())

  application Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reason      RejectionReason? @relation(fields: [reasonId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([rejectedAt])
  @@map("rejection_records")
}

model Offer {
  id             String   @id @default(cuid())
  applicationId  String   @unique
  baseSalary     Int?
  currency       String   @default("USD")
  bonus          String?
  ptoDays        Int?
  remotePolicy   String?
  benefits       String[] @default([])
  contractType   String?
  equipment      String?
  insurance      String?
  flexibility    String?
  notes          String?  @db.Text
  isAccepted     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("offers")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json             @default("{}")
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================================
// AUDIT & SECURITY
// ============================================================================

model AuditLog {
  id             String      @id @default(cuid())
  userId         String?
  organizationId String?
  action         AuditAction
  resource       String
  resourceId     String?
  metadata       Json        @default("{}")
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SecurityEvent {
  id             String            @id @default(cuid())
  userId         String?
  organizationId String?
  type           SecurityEventType
  description    String
  ipAddress      String?
  userAgent      String?
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("security_events")
}

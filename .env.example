# =============================================================================
# PassaPortal environment variables
# Copy this file to .env and replace every CHANGE_ME value.
# NEVER commit .env — it is listed in .gitignore.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=passaportal
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=passaportal
POSTGRES_PORT=5432

# Local app connection (use localhost when running npm run dev on the host)
DATABASE_URL="postgresql://passaportal:CHANGE_ME@localhost:5432/passaportal?schema=public"
# Prisma migrations / direct connection (same as DATABASE_URL locally)
DATABASE_URL_UNPOOLED="postgresql://passaportal:CHANGE_ME@localhost:5432/passaportal?schema=public"

# --- Production (Vercel + Neon) — paste Neon integration vars as-is ---
# DATABASE_URL              → Neon "pooled" string (*-pooler host)
# DATABASE_URL_UNPOOLED     → Neon "unpooled" string (no pooler host)
# Optional aliases Neon may also inject (do not duplicate manually if already set):
# POSTGRES_PRISMA_URL       → same as DATABASE_URL (pooled)
# POSTGRES_URL_NON_POOLING → same as DATABASE_URL_UNPOOLED
# AUTH_URL                  → https://your-app.vercel.app

# --- Redis ---
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379

# --- Application ---
APP_PORT=3000
NODE_ENV=development

# --- Auth.js (session signing) ---
# Generate: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME
AUTH_URL="http://localhost:3000"

# --- Field encryption (AES-256-GCM) ---
# Generate: openssl rand -hex 32  (must be exactly 64 hex characters)
ENCRYPTION_KEY=CHANGE_ME

# --- UploadThing (optional) ---
UPLOADTHING_TOKEN=""
UPLOADTHING_APP_ID=""

# --- Resend (optional) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# --- Stripe (optional) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Session ---
SESSION_MAX_AGE=86400
SESSION_UPDATE_AGE=3600

# --- Demo seed (development / staging only — never enable in production) ---
# Password used for all demo accounts created by: npm run db:seed
SEED_DEMO_PASSWORD=CHANGE_ME
# Must stay false in production. Set true only when intentionally seeding demo data.
ALLOW_DEMO_SEED=false

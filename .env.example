# Database
DATABASE_URL="postgresql://talentos:talentos_secret@localhost:5432/talentos?schema=public"

# Auth.js
AUTH_SECRET="generate-a-secure-random-secret-min-32-chars"
AUTH_URL="http://localhost:3000"

# Encryption (32-byte hex key for AES-256)
ENCRYPTION_KEY="generate-64-char-hex-key-for-aes-256-encryption"

# UploadThing
UPLOADTHING_TOKEN=""
UPLOADTHING_APP_ID=""

# Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@talentos.app"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Session
SESSION_MAX_AGE=86400
SESSION_UPDATE_AGE=3600
